[Unit]
Description=Inky Impression button monitor
After=network.target

[Service]
Type=simple
User=gertjan
WorkingDirectory=/home/gertjan/frame
ExecStart=/home/gertjan/.virtualenvs/pimoroni/bin/python3 -u /home/gertjan/frame/buttons.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
